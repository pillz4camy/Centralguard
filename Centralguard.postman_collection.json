{
  "info": {
    "_postman_id": "centralguard-api-collection-2026",
    "name": "Centralguard API - Colección Oficial (Trimestre 5)",
    "description": "Colección completa para pruebas de la API REST Centralguard con autenticación JWT, roles (administrador y vigilante) y códigos de estado HTTP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Salud del Servidor",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Autenticación & Usuarios",
      "item": [
        {
          "name": "Registrar Administrador",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Admin\",\n  \"apellido\": \"Principal\",\n  \"documento\": \"123123\",\n  \"correo\": \"admin@centralguard.com\",\n  \"contrasenia\": \"123456\",\n  \"rol\": \"administrador\",\n  \"telefono\": {\n    \"tipo\": \"móvil\",\n    \"numero\": \"3001234567\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          }
        },
        {
          "name": "Registrar Vigilante",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"Guarda\",\n  \"documento\": \"987654\",\n  \"correo\": \"vigilante@centralguard.com\",\n  \"contrasenia\": \"123456\",\n  \"rol\": \"vigilante\",\n  \"telefono\": {\n    \"tipo\": \"móvil\",\n    \"numero\": \"3107654321\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          }
        },
        {
          "name": "Iniciar Sesión (Login) - Guarda Token Automático",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.environment.set(\"token\", json.token);",
                  "        console.log(\"Token JWT guardado automáticamente en el entorno\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@centralguard.com\",\n  \"contrasenia\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "login"]
            }
          }
        },
        {
          "name": "Obtener Perfil Autenticado",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users/perfil",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "perfil"]
            }
          }
        },
        {
          "name": "Listar Usuarios (Solo Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users?rol=administrador",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [{ "key": "rol", "value": "administrador" }]
            }
          }
        }
      ]
    },
    {
      "name": "2. Conjuntos",
      "item": [
        {
          "name": "Crear Conjunto (Solo Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_conjunto\": \"Conjunto Residencial Los Robles\",\n  \"nit\": \"901234567-8\",\n  \"direccion\": \"Carrera 45 # 120-30\",\n  \"correo_electronico\": \"admin@losrobles.com\",\n  \"telefono\": {\n    \"tipo\": \"fijo\",\n    \"numero\": \"6016543210\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conjuntos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conjuntos"]
            }
          }
        },
        {
          "name": "Listar Conjuntos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/conjuntos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conjuntos"]
            }
          }
        }
      ]
    },
